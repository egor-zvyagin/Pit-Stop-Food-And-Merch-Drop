# Next.js Application Environment Variables
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Geospatial: Mapbox GL Public Token (leave empty to use built-in offline Albert Park SVG fallback)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# AWS Configuration (ap-southeast-2)
AWS_REGION=ap-southeast-2
DYNAMODB_TABLE_NAME=pitstop_data
USE_LOCAL_STORAGE=true

# Cryptographic Keys (Ed25519 Pass Signing - generated automatically if left empty)
ED25519_KEY_ID=AGPC-2027-KEY-01
ED25519_PRIVATE_KEY_BASE64=
ED25519_PUBLIC_KEY_BASE64=
NEXT_PUBLIC_ED25519_PUBLIC_KEY=
VENDOR_ACCESS_PIN=2026
