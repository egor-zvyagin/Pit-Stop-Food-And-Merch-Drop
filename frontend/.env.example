# Next.js Application Environment Variables
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Data store. USE_LOCAL_STORAGE=true keeps everything in memory (local dev,
# tests). Set it to false to use DynamoDB with your AWS credentials; a failing
# database then returns errors, it never falls back to in-memory data.
AWS_REGION=ap-southeast-2
DYNAMODB_TABLE_NAME=pitstop_data
USE_LOCAL_STORAGE=true

# Pass signing key (Ed25519). There is no built-in default.
# - Leave empty for `npm run dev` and the tests: a throwaway key is generated
#   for that session.
# - Required for `npm run start`, `npm run seed` and any deployment.
#   Create one with: npm run keygen
ED25519_KEY_ID=AGPC-2027-KEY-01
ED25519_PRIVATE_KEY_BASE64=
ED25519_PUBLIC_KEY_BASE64=

# Staff PIN for the vendor terminal. Required: with no value set, every vendor
# request is refused. Choose your own and never commit it.
VENDOR_ACCESS_PIN=
